{
  "name": "stock-images-mcp",
  "version": "1.0.0",
  "description": "MCP server to search and download stock images from Pexels, Unsplash, and Pixabay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeanpfs/stock-images-mcp.git"
  },
  "homepage": "https://github.com/jeanpfs/stock-images-mcp#readme",
  "bugs": {
    "url": "https://github.com/jeanpfs/stock-images-mcp/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "stock-images-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "stock-images",
    "pexels",
    "unsplash",
    "pixabay"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
