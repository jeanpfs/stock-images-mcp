{
  "name": "stock-images-mcp",
  "version": "1.0.0",
  "description": "MCP server to search and download stock images from Pexels, Unsplash, and Pixabay",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "stock-images-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["mcp", "stock-images", "pexels", "unsplash", "pixabay"],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
